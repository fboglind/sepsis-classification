      ],
      "source": [
        "# Verify sepsis labels are constant per patient\n",
        "print(\"\\nVerifying sepsis labels...\")\n",
        "for name, data in [('A', data_A), ('B', data_B), ('C', data_C), ('D', data_D)]:\n",
        "    sepsis_variance = data.groupby('id')['sepsis'].std()\n",
